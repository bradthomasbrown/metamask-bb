{
  "action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "19": "images/icon-19.png",
      "32": "images/icon-32.png",
      "38": "images/icon-38.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png",
      "512": "images/icon-512.png"
    },
    "default_title": "metamask-bb (unofficial fork)",
    "default_popup": "popup-init.html"
  },
  "author": "https://metamask.io",
  "background": {
    "service_worker": "service-worker.ts"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "windows": "Alt+Shift+M",
        "mac": "Alt+Shift+M",
        "chromeos": "Alt+Shift+M",
        "linux": "Alt+Shift+M"
      }
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "windows": "Alt+Shift+M",
        "mac": "Alt+Shift+M",
        "chromeos": "Alt+Shift+M",
        "linux": "Alt+Shift+M"
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["file://*/*", "http://*/*", "https://*/*"],
      "js": ["scripts/contentscript.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["file://*/*", "http://*/*", "https://*/*"],
      "js": ["scripts/inpage.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://x.com/*", "https://www.x.com/*"],
      "css": [
        "scripts/cashtag/pill/page.css",
        "scripts/cashtag/widget/page.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["*://connect.trezor.io/*/popup.html*"],
      "js": ["vendor/trezor/content-script.js"]
    }
  ],
  "default_locale": "en",
  "description": "Unofficial experimental MetaMask fork with an additional direct key-import setup option. Not affiliated with or endorsed by ConsenSys.",
  "host_permissions": [
    "http://localhost:8545/",
    "file://*/*",
    "http://*/*",
    "https://*/*",
    "ws://*/*",
    "wss://*/*"
  ],
  "icons": {
    "16": "images/icon-16.png",
    "19": "images/icon-19.png",
    "32": "images/icon-32.png",
    "38": "images/icon-38.png",
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "128": "images/icon-128.png",
    "512": "images/icon-512.png"
  },
  "manifest_version": 3,
  "name": "metamask-bb (unofficial experimental fork)",
  "optional_permissions": ["clipboardRead"],
  "permissions": [
    "activeTab",
    "alarms",
    "notifications",
    "scripting",
    "storage",
    "unlimitedStorage",
    "webRequest",
    "offscreen",
    "identity",
    "sidePanel",
    "cookies"
  ],
  "sandbox": {
    "pages": ["snaps/index.html"]
  },
  "short_name": "metamask-bb",
  "web_accessible_resources": [
    {
      "resources": ["cashtag-widget.html"],
      "matches": ["https://x.com/*", "https://www.x.com/*"]
    }
  ]
}
